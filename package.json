{
  "name": "pen-trackr",
  "version": "0.0.0",
  "private": true,
  "description": "An engagement operating system for authorized penetration testing",
  "license": "Apache-2.0",
  "author": "Robert Weber",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyberSecDef/pen.trackr.live.git"
  },
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --sequential run build",
    "typecheck": "tsc --build --verbose",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "trace": "tsc --build tools/trace && node tools/trace/dist/cli.js",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run trace && pnpm run hygiene",
    "test:coverage": "vitest run --coverage",
    "hygiene": "tsc --build tools/hygiene && node tools/hygiene/dist/cli.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.9.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
