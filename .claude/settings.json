{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.claude/hooks/hygiene-staged.sh\"",
            "if": "Bash(git commit*)",
            "timeout": 30,
            "statusMessage": "Checking repository hygiene"
          }
        ]
      }
    ]
  }
}
